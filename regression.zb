var total = 0;
var threshold = 5;

for (var i = 1; i <= threshold; i = i + 1) {
  var square = i * i;
  if (square > 10 and square < 20) {
    print square;
  } else if (square >= 20) {
    total = total + square;
  }
}
print total;

